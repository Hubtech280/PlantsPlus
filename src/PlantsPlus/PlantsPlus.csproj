<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PlantsPlus</AssemblyName>
    <RootNamespace>PlantsPlus</RootNamespace>
    <OutputType>Library</OutputType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.21</AssemblyVersion>
    <FileVersion>1.2.0.21</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../build/</OutputPath>
    <EnableMagnetOPea Condition="'$(EnableMagnetOPea)' == ''">true</EnableMagnetOPea>
  </PropertyGroup>

  <PropertyGroup>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == '' and '$(PVZF_GAME_DIR)' != ''">$(PVZF_GAME_DIR)/MelonLoader</ReferenceRoot>
    <MelonLoaderRefs>$(ReferenceRoot)/net6</MelonLoaderRefs>
    <Il2CppRefs>$(ReferenceRoot)/Il2CppAssemblies</Il2CppRefs>
    <CustomizeLibPath Condition="'$(CustomizeLibPath)' == '' and '$(PVZF_GAME_DIR)' != ''">$(PVZF_GAME_DIR)/Mods/CustomizeLib.MelonLoader.dll</CustomizeLibPath>
    <DefineConstants Condition="'$(EnableMagnetOPea)' == 'true'">$(DefineConstants);ENABLE_MAGNETOPEA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Magnet-o-pea is enabled for the beta; set EnableMagnetOPea=false for a fallback build. -->
    <EmbeddedResource Include="Resources/AssetBundles/cherry_cabbage" LogicalName="PlantsPlus.Resources.AssetBundles.cherry_cabbage" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_cherrycabbage" LogicalName="PlantsPlus.Resources.AssetBundles.bullet_cherrycabbage" />
    <EmbeddedResource Include="Resources/AssetBundles/lob_shroom" LogicalName="PlantsPlus.Resources.AssetBundles.lob_shroom" />
    <EmbeddedResource Include="Resources/AssetBundles/nightroofmap" LogicalName="PlantsPlus.Resources.AssetBundles.nightroofmap" />
    <Compile Remove="Plants/MagnetOPea.cs" Condition="'$(EnableMagnetOPea)' != 'true'" />

    <EmbeddedResource Include="Resources/AssetBundles/bambnut"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bambnut" />
    <EmbeddedResource Include="Resources/AssetBundles/lotuspumpkin"
                      LogicalName="PlantsPlus.Resources.AssetBundles.lotuspumpkin" />
    <EmbeddedResource Include="Resources/AssetBundles/icebergshroom"
                      LogicalName="PlantsPlus.Resources.AssetBundles.icebergshroom" />
    <EmbeddedResource Include="Resources/AssetBundles/witchfire_pumpkin"
                      LogicalName="PlantsPlus.Resources.AssetBundles.witchfire_pumpkin" />
    <EmbeddedResource Include="Resources/AssetBundles/nuttysharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.nuttysharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/nss_bullet"
                      LogicalName="PlantsPlus.Resources.AssetBundles.nss_bullet" />
    <EmbeddedResource Include="Resources/AssetBundles/infernotorchflower"
                      LogicalName="PlantsPlus.Resources.AssetBundles.infernotorchflower" />
    <EmbeddedResource Include="Resources/AssetBundles/pumpkinpodbomber"
                      LogicalName="PlantsPlus.Resources.AssetBundles.pumpkinpodbomber" />
    <EmbeddedResource Include="Resources/AssetBundles/ceasarweed"
                      LogicalName="PlantsPlus.Resources.AssetBundles.ceasarweed" />
    <EmbeddedResource Include="Resources/AssetBundles/solarfirnace"
                      LogicalName="PlantsPlus.Resources.AssetBundles.solarfirnace" />
    <EmbeddedResource Include="Resources/AssetBundles/notapea"
                      LogicalName="PlantsPlus.Resources.AssetBundles.notapea" />
    <EmbeddedResource Include="Resources/AssetBundles/notastormcommando"
                      LogicalName="PlantsPlus.Resources.AssetBundles.notastormcommando" />
    <EmbeddedResource Include="Resources/AssetBundles/frostfurflower"
                      LogicalName="PlantsPlus.Resources.AssetBundles.frostfurflower" />
    <EmbeddedResource Include="Resources/AssetBundles/doomtronion"
                      LogicalName="PlantsPlus.Resources.AssetBundles.doomtronion" />
    <EmbeddedResource Include="Resources/Sprites/doomtronion_biu.png"
                      LogicalName="PlantsPlus.Resources.Sprites.doomtronion_biu.png" />
    <EmbeddedResource Include="Resources/Sprites/night_roof_card.png"
                      LogicalName="PlantsPlus.Resources.Sprites.night_roof_card.png" />
    <EmbeddedResource Include="Resources/Sprites/plants_v1_2_logo.png"
                      LogicalName="PlantsPlus.Resources.Sprites.plants_v1_2_logo.png" />
    <EmbeddedResource Include="Resources/Sprites/EditorMaps/*.png" />
    <EmbeddedResource Include="Resources/AssetBundles/lichenpea"
                      LogicalName="PlantsPlus.Resources.AssetBundles.lichenpea" />
    <EmbeddedResource Include="Resources/AssetBundles/logicblover"
                      LogicalName="PlantsPlus.Resources.AssetBundles.logicblover" />
    <EmbeddedResource Include="Resources/AssetBundles/solarsharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.solarsharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_solarsharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_solarsharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/seaballista"
                      LogicalName="PlantsPlus.Resources.AssetBundles.seaballista" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_seaballista"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_seaballista" />
    <EmbeddedResource Include="Resources/AssetBundles/pineshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.pineshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_pineshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_pineshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/icytronion"
                      LogicalName="PlantsPlus.Resources.AssetBundles.icytronion" />
    <EmbeddedResource Include="Resources/AssetBundles/seasharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.seasharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_seasharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_seasharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/cherrystarbomber"
                      LogicalName="PlantsPlus.Resources.AssetBundles.cherrystarbomber" />
    <EmbeddedResource Include="Resources/AssetBundles/three_buckpeater"
                      LogicalName="PlantsPlus.Resources.AssetBundles.three_buckpeater" />
    <EmbeddedResource Include="Resources/AssetBundles/sakurasharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.sakurasharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_sakurasharpshooter"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_sakurasharpshooter" />
    <EmbeddedResource Include="Resources/AssetBundles/boreal_orchid"
                      LogicalName="PlantsPlus.Resources.AssetBundles.boreal_orchid" />
    <EmbeddedResource Include="Resources/AssetBundles/bomberdrone"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bomberdrone" />
    <EmbeddedResource Include="Resources/AssetBundles/frostbitedrone"
                      LogicalName="PlantsPlus.Resources.AssetBundles.frostbitedrone" />
    <EmbeddedResource Include="Resources/AssetBundles/ice_lord_cactus"
                      LogicalName="PlantsPlus.Resources.AssetBundles.ice_lord_cactus" />
    <EmbeddedResource Include="Resources/AssetBundles/scoviliapepper"
                      LogicalName="PlantsPlus.Resources.AssetBundles.scoviliapepper" />
    <EmbeddedResource Include="Resources/AssetBundles/atomray_shroom"
                      LogicalName="PlantsPlus.Resources.AssetBundles.atomray_shroom" />
    <EmbeddedResource Include="Resources/AssetBundles/sauerkraut_pult"
                      LogicalName="PlantsPlus.Resources.AssetBundles.sauerkraut_pult" />
    <EmbeddedResource Include="Resources/AssetBundles/sauerkraut_pult_bullet"
                      LogicalName="PlantsPlus.Resources.AssetBundles.sauerkraut_pult_bullet" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_lichenpea"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_lichenpea" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_notapea"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_notapea" />
    <EmbeddedResource Include="Resources/AssetBundles/bullet_magnetopea"
                      LogicalName="PlantsPlus.Resources.AssetBundles.bullet_magnetopea"
                      Condition="'$(EnableMagnetOPea)' == 'true'" />
    <EmbeddedResource Include="Resources/AssetBundles/magnetopea"
                      LogicalName="PlantsPlus.Resources.AssetBundles.magnetopea"
                      Condition="'$(EnableMagnetOPea)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(MelonLoaderRefs)/MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MelonLoaderRefs)/0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(MelonLoaderRefs)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="System.Runtime.CompilerServices.Unsafe" HintPath="$(MelonLoaderRefs)/System.Runtime.CompilerServices.Unsafe.dll" Private="false" />

    <Reference Include="CustomizeLib.MelonLoader" HintPath="$(CustomizeLibPath)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Il2CppRefs)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(Il2CppRefs)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppSystem" HintPath="$(Il2CppRefs)/Il2CppSystem.dll" Private="false" />
    <Reference Include="Il2CppSystem.Core" HintPath="$(Il2CppRefs)/Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(Il2CppRefs)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(Il2CppRefs)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Il2CppRefs)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Il2CppRefs)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(Il2CppRefs)/UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(Il2CppRefs)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Il2CppRefs)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Il2CppRefs)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Il2CppRefs)/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MelonLoaderRefs)/MelonLoader.dll')"
           Text="MelonLoader.dll not found. Set ReferenceRoot to the game's MelonLoader folder, or set PVZF_GAME_DIR to the game folder." />
    <Error Condition="!Exists('$(Il2CppRefs)/Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found. Generate/install the game's MelonLoader Il2CppAssemblies first." />
    <Error Condition="!Exists('$(CustomizeLibPath)')"
           Text="CustomizeLib.MelonLoader.dll not found. Set CustomizeLibPath or place the MelonLoader port in the game's Mods folder." />
  </Target>
</Project>
